[Unit]
Description=Weston desktop requested by the Viruaisor host (%i)
After=systemd-user-sessions.service
ConditionPathExists=/etc/systemd/user/weston.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Built-in/already-loaded drivers need no matching /lib/modules tree.
# Keep a real load failure fatal when the driver is absent.
ExecStartPre=/bin/sh -ec 'test -d /sys/module/virtio_gpu || exec /sbin/modprobe virtio_gpu'
ExecStart=/usr/local/sbin/avf-desktop start %i
ExecStop=/usr/local/sbin/avf-desktop stop
TimeoutStartSec=30
TimeoutStopSec=15

# Intentionally no [Install] section: this unit must never be enabled or started by a target.
