+#ifdef VN_USE_WSI_PLATFORM
+static bool
+vn_desktop_async_sync_fd(const struct vn_device *dev)
+{
+   /* VIRUAISOR_DESKTOP_ASYNC_SYNC_FD: only the explicitly opted-in Zink
+    * display process may return its real completion fd before it signals.
+    * Zink transfers this dependency through DMA_BUF_IOCTL_IMPORT_SYNC_FILE;
+    * its next consumer imports/waits for it. Keep the compatibility CPU wait
+    * for other applications and inherited child-process environments.
+    */
+   if (!dev->instance->engine_is_zink)
+      return false;
+
+   const char *owner = getenv("VIRUAISOR_DESKTOP_ASYNC_SYNC_FD_PID");
+   if (!owner)
+      return false;
+
+   char current[32];
+   snprintf(current, sizeof(current), "%ld", (long)getpid());
+   return strcmp(owner, current) == 0;
+}
+#endif
