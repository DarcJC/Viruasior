 #include "vn_queue.h"
 
+#include <stdlib.h>
+
 /* The common WSI support makes some assumptions about the driver.
  *
  * In wsi_device_init, it assumes VK_EXT_pci_bus_info is available.  In
@@ -88,6 +90,10 @@ vn_wsi_init(struct vn_physical_device *physical_dev)
       return result;
 
    physical_dev->wsi_device.supports_modifiers = true;
+   /* The paired Android renderer only imports BGRA8 UNORM scanout images.
+    * Other advertised formats fall back to BLOB allocations on this device. */
+   physical_dev->wsi_device.viruaisor_ahb_unorm_wsi =
+      getenv("VIRUAISOR_AHB_UNORM_WSI") != NULL;
    physical_dev->base.base.wsi_device = &physical_dev->wsi_device;
 
    return VK_SUCCESS;
