diff --git a/src/vulkan/wsi/wsi_common_x11.c b/src/vulkan/wsi/wsi_common_x11.c
index b2204fb..e5461f1 100644
--- a/src/vulkan/wsi/wsi_common_x11.c
+++ b/src/vulkan/wsi/wsi_common_x11.c
@@ -865,11 +865,17 @@ get_sorted_vk_formats(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
    /* use the root window's visual to set the default */
    *count = 0;
    for (unsigned i = 0; i < ARRAY_SIZE(formats); i++) {
+      if (wsi_device->viruaisor_ahb_unorm_wsi &&
+          formats[i] != VK_FORMAT_B8G8R8A8_UNORM)
+         continue;
       if (rgb_component_bits_are_equal(formats[i], rootvis))
          sorted_formats[(*count)++] = formats[i];
    }
 
    for (unsigned i = 0; i < ARRAY_SIZE(formats); i++) {
+      if (wsi_device->viruaisor_ahb_unorm_wsi &&
+          formats[i] != VK_FORMAT_B8G8R8A8_UNORM)
+         continue;
       for (unsigned j = 0; j < *count; j++)
          if (formats[i] == sorted_formats[j])
             goto next_format;
