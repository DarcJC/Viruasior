+static void
+proxy_context_trace_fd(const char *stage, uint32_t ctx_id, uint32_t res_id, int fd)
+{
+   struct stat st = {0};
+   const int stat_ret = fstat(fd, &st);
+   char fd_path[64];
+   char fd_target[256];
+   snprintf(fd_path, sizeof(fd_path), "/proc/self/fd/%d", fd);
+   ssize_t target_length = readlink(fd_path, fd_target, sizeof(fd_target) - 1);
+   if (target_length < 0)
+      target_length = 0;
+   fd_target[target_length] = 0;
+   proxy_log("VIRUAISOR_PROXY_FD stage=%s pid=%d ctx=%u res=%u fd=%d stat=%d "
+             "dev=%llu ino=%llu size=%lld target=%s",
+             stage, getpid(), ctx_id, res_id, fd, stat_ret,
+             stat_ret ? 0ULL : (unsigned long long)st.st_dev,
+             stat_ret ? 0ULL : (unsigned long long)st.st_ino,
+             stat_ret ? 0LL : (long long)st.st_size, fd_target);
+}
