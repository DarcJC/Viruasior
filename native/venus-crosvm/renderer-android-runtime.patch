+/* Fixed Android allocator: no root, device selection, or guest-provided path. */
+static VkResult
+vkr_android_import(struct vkr_device *dev, VkMemoryAllocateInfo *info, uint32_t property_flags,
+                   int *retained_fd, AHardwareBuffer **out_buffer, VkImportMemoryFdInfoKHR *import)
+{
+   const uint64_t bytes = venus_heap_allocation_size(info->allocationSize, getpagesize());
+   if (!bytes)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   AHardwareBuffer *buffer = NULL;
+   int fd = venus_gralloc_allocate(bytes, property_flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT, &buffer);
+   if (fd < 0) {
+      vkr_log("VIRUAISOR_GRALLOC_ALLOC_FAILED result=%d", fd);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   VkMemoryFdPropertiesKHR properties = {.sType=VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR};
+   if (!dev->proc_table.GetMemoryFdPropertiesKHR) { close(fd); venus_ahb_release(buffer); return VK_ERROR_FEATURE_NOT_PRESENT; }
+   VkResult ret = dev->proc_table.GetMemoryFdPropertiesKHR(dev->base.handle.device,
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd, &properties);
+   vkr_log("VIRUAISOR_GRALLOC_IMPORT bytes=%" PRIu64 " type=%u fd_types=%x vk=%d", bytes, info->memoryTypeIndex, properties.memoryTypeBits, ret);
+   if (ret != VK_SUCCESS || !venus_heap_memory_type_valid(info->memoryTypeIndex, properties.memoryTypeBits)) {
+      close(fd);
+      venus_ahb_release(buffer);
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+   int duplicate = os_dupfd_cloexec(fd);
+   if (duplicate < 0) { close(fd); venus_ahb_release(buffer); return VK_ERROR_OUT_OF_HOST_MEMORY; }
+   *retained_fd = fd;
+   *out_buffer = buffer;
+   *import = (VkImportMemoryFdInfoKHR){.sType=VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext=info->pNext, .handleType=VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, .fd=duplicate};
+   info->allocationSize = bytes;
+   return VK_SUCCESS;
+}
+#endif
+
+static int
+vkr_dma_sync(int fd, uint64_t flags, UNUSED void *cookie)
+{
+#ifdef __ANDROID__
+   struct dma_buf_sync request = {.flags=flags};
+   return ioctl(fd, DMA_BUF_IOCTL_SYNC, &request);
+#else
+   (void)fd; (void)flags; errno=ENOTSUP; return -1;
+#endif
+}
+
+static VkResult
+vkr_cache_ranges(uint32_t count, const VkMappedMemoryRange *ranges, bool invalidate)
+{
+#ifdef __ANDROID__
+   for (uint32_t i=0; i<count; ++i) {
+      struct vkr_device_memory *mem = vkr_device_memory_from_handle(ranges[i].memory);
+      if (!mem || !mem->exported || mem->udmabuf_fd < 0 ||
+          !venus_cache_range_valid(mem->allocation_size, ranges[i].offset, ranges[i].size))
+         return VK_ERROR_MEMORY_MAP_FAILED;
+      if (venus_cache_sync(mem->udmabuf_fd, invalidate, vkr_dma_sync, NULL)) {
+         vkr_log("VIRUAISOR_CACHE_SYNC_FAILED invalidate=%d errno=%d", invalidate, errno);
+         return VK_ERROR_MEMORY_MAP_FAILED;
+      }
+   }
+   vkr_log("VIRUAISOR_CACHE_%s ranges=%u", invalidate ? "INVALIDATE" : "FLUSH", count);
+   return VK_SUCCESS;
+#else
+   (void)count; (void)ranges; (void)invalidate; return VK_ERROR_FEATURE_NOT_PRESENT;
+#endif
+}
+
+static void
+vkr_dispatch_vkFlushMappedMemoryRanges(UNUSED struct vn_dispatch_context *dispatch,
+                                       struct vn_command_vkFlushMappedMemoryRanges *args)
+{
+   args->ret = vkr_cache_ranges(args->memoryRangeCount, args->pMemoryRanges, false);
+}
+
+static void
+vkr_dispatch_vkInvalidateMappedMemoryRanges(UNUSED struct vn_dispatch_context *dispatch,
+                                            struct vn_command_vkInvalidateMappedMemoryRanges *args)
+{
+   args->ret = vkr_cache_ranges(args->memoryRangeCount, args->pMemoryRanges, true);
+}
