+/* VIRUAISOR_DISPLAY_FENCE_LIFETIME: never destroy an in-flight fence. */
+static bool
+vkr_display_fence_create(void *opaque, uintptr_t *handle)
+{
+   struct vkr_queue *queue = opaque;
+   struct vkr_device *dev = queue->device;
+   const VkFenceCreateInfo info = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+   VkFence fence = VK_NULL_HANDLE;
+   if (dev->proc_table.CreateFence(dev->base.handle.device, &info, NULL, &fence) != VK_SUCCESS)
+      return false;
+   *handle = (uintptr_t)fence;
+   return true;
+}
+static bool
+vkr_display_fence_submit(void *opaque, uintptr_t handle)
+{
+   struct vkr_queue *queue = opaque;
+   mtx_lock(&queue->vk_mutex);
+   VkResult result = queue->device->proc_table.QueueSubmit(
+      queue->base.handle.queue, 0, NULL, (VkFence)handle);
+   mtx_unlock(&queue->vk_mutex);
+   return result == VK_SUCCESS;
+}
+static int
+vkr_display_fence_wait(void *opaque, uintptr_t handle, uint64_t timeout_ns)
+{
+   struct vkr_queue *queue = opaque;
+   struct vkr_device *dev = queue->device;
+   VkFence fence = (VkFence)handle;
+   VkResult result = dev->proc_table.WaitForFences(
+      dev->base.handle.device, 1, &fence, VK_TRUE, timeout_ns);
+   return result == VK_SUCCESS ? 1 : result == VK_TIMEOUT ? 0 : -1;
+}
+static void
+vkr_display_fence_destroy(void *opaque, uintptr_t handle)
+{
+   struct vkr_queue *queue = opaque;
+   queue->device->proc_table.DestroyFence(queue->device->base.handle.device,
+                                         (VkFence)handle, NULL);
+}
