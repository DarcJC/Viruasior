+vkr_android_ahb_image(VkImage handle)
+{
+   struct vkr_image *image = vkr_image_from_handle(handle);
+   return image && image->android_hardware_buffer_external ? image : NULL;
+}
+
+static void
+vkr_android_trace_ahb_image_write(const char *kind, VkImage handle)
+{
+   struct vkr_image *image = vkr_android_ahb_image(handle);
