+int
+vkr_queue_wait_for_display(struct vkr_queue *queue, uint64_t timeout_ns)
+{
+   struct vkr_device *dev = queue->device;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   const VkFenceCreateInfo create_info = {
+      .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+   };
+   VkFence fence = VK_NULL_HANDLE;
+   VkResult result = vk->CreateFence(dev->base.handle.device,
+                                     &create_info, NULL, &fence);
+   if (result != VK_SUCCESS)
+      return -1;
+
+   /* Order this fence after the render submissions already decoded from the
+    * Venus ring.  Release the queue lock before waiting so new work can be
+    * submitted and the guest cannot be stalled by display refresh. */
+   mtx_lock(&queue->vk_mutex);
+   result = vk->QueueSubmit(queue->base.handle.queue, 0, NULL, fence);
+   mtx_unlock(&queue->vk_mutex);
+   if (result == VK_SUCCESS)
+      result = vk->WaitForFences(dev->base.handle.device, 1, &fence,
+                                 VK_TRUE, timeout_ns);
+   vk->DestroyFence(dev->base.handle.device, fence, NULL);
+
+   if (result == VK_SUCCESS)
+      return 1;
+   if (result == VK_TIMEOUT)
+      return 0;
+   return -1;
+}
