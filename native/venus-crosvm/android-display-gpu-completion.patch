+int
+vkr_context_wait_queues_for_display(struct vkr_context *ctx,
+                                    uint64_t timeout_ns,
+                                    unsigned *out_queue_count)
+{
+   assert(out_queue_count);
+   *out_queue_count = 0;
+   if (!ctx->instance)
+      return 1;
+
+   bool ready = true;
+   for (uint32_t i = 0; i < ctx->instance->physical_device_count; ++i) {
+      struct vkr_physical_device *physical = ctx->instance->physical_devices[i];
+      list_for_each_entry (struct vkr_device, dev, &physical->devices,
+                           base.track_head) {
+         list_for_each_entry (struct vkr_queue, queue, &dev->queues,
+                              base.track_head) {
+            (*out_queue_count)++;
+            const int status = vkr_queue_wait_for_display(queue, timeout_ns);
+            if (status < 0)
+               return -1;
+            if (!status)
+               ready = false;
+         }
+      }
+   }
+   return ready ? 1 : 0;
+}
