+
+/* VIRUAISOR_AHB_RESOURCE_LIFETIME: a guest DMA-BUF outlives VkDeviceMemory.
+ * Keep both the AHB and its lookup entry until every exported resource is gone. */
+bool
+viruaisor_ahb_resource_acquire(int fd, void **out_buffer)
+{
+   *out_buffer = NULL;
+   struct stat st;
+   if (fd < 0 || fstat(fd, &st))
+      return false;
+   pthread_mutex_lock(&viruaisor_ahb_registry_mutex);
+   AHardwareBuffer *buffer = venus_ahb_registry_find(
+      viruaisor_ahb_registry, VIRUAISOR_AHB_REGISTRY_CAPACITY,
+      (uint64_t)st.st_dev, (uint64_t)st.st_ino);
+   bool retained = true;
+   if (buffer) {
+      retained = venus_ahb_registry_add(
+         viruaisor_ahb_registry, VIRUAISOR_AHB_REGISTRY_CAPACITY,
+         (uint64_t)st.st_dev, (uint64_t)st.st_ino, buffer);
+      if (retained) {
+         AHardwareBuffer_acquire(buffer);
+         *out_buffer = buffer;
+      }
+   }
+   pthread_mutex_unlock(&viruaisor_ahb_registry_mutex);
+   return retained;
+}
+
+void
+viruaisor_ahb_resource_release(int fd, void *buffer)
+{
+   if (!buffer)
+      return;
+   viruaisor_ahb_unregister(fd, buffer);
+   AHardwareBuffer_release(buffer);
 }
 
