diff --git a/src/vkutil/find_matching_memory_type.cpp b/src/vkutil/find_matching_memory_type.cpp
index 9e8c9ba..8ad2034 100644
--- a/src/vkutil/find_matching_memory_type.cpp
+++ b/src/vkutil/find_matching_memory_type.cpp
@@ -42,3 +42,12 @@ uint32_t vkutil::find_matching_memory_type(
 
     throw std::runtime_error("Couldn't find matching memory type");
 }
+
+void vkutil::flush_mapped_memory(VulkanState& vulkan, vk::DeviceMemory memory)
+{
+    auto const range = vk::MappedMemoryRange{}
+        .setMemory(memory)
+        .setOffset(0)
+        .setSize(VK_WHOLE_SIZE);
+    vulkan.device().flushMappedMemoryRanges(range);
+}
