 #include <fcntl.h>
 #include <linux/dma-heap.h>
 #include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static void
+vkr_trace_dma_buf_fd(const char *stage, uint64_t object_id, uint32_t res_id, int fd)
+{
+   struct stat st = {0};
+   const int stat_ret = fstat(fd, &st);
+   const int descriptor_flags = fcntl(fd, F_GETFD);
+   char fd_path[64];
+   char fd_target[256];
+   snprintf(fd_path, sizeof(fd_path), "/proc/self/fd/%d", fd);
+   ssize_t target_length = readlink(fd_path, fd_target, sizeof(fd_target) - 1);
+   if (target_length < 0)
+      target_length = 0;
+   fd_target[target_length] = 0;
+   vkr_log("VIRUAISOR_DMA_BUF_FD stage=%s pid=%d object=%" PRIu64
+           " res=%u fd=%d flags=%d stat=%d dev=%ju ino=%ju size=%jd mode=%jo target=%s",
+           stage, getpid(), object_id, res_id, fd, descriptor_flags, stat_ret,
+           stat_ret ? UINTMAX_C(0) : (uintmax_t)st.st_dev,
+           stat_ret ? UINTMAX_C(0) : (uintmax_t)st.st_ino,
+           stat_ret ? INTMAX_C(0) : (intmax_t)st.st_size,
+           stat_ret ? UINTMAX_C(0) : (uintmax_t)st.st_mode, fd_target);
+}

