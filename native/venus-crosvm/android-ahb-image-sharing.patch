 /* Fixed Android allocator: no root, device selection, or guest-provided path. */
+static PFN_vkGetAndroidHardwareBufferPropertiesANDROID
+vkr_android_get_ahb_properties_proc(struct vkr_device *dev)
+{
+   return (PFN_vkGetAndroidHardwareBufferPropertiesANDROID)
+      dev->physical_device->proc_table.GetDeviceProcAddr(
+         dev->base.handle.device,
+         "vkGetAndroidHardwareBufferPropertiesANDROID");
+}
+
+static uint32_t
+vkr_android_select_import_type(struct vkr_device *dev, uint32_t selected,
+                               uint32_t compatible, uint32_t property_flags)
+{
+   VkPhysicalDeviceMemoryProperties native_properties;
+   dev->physical_device->proc_table.GetPhysicalDeviceMemoryProperties(
+      dev->physical_device->base.handle.physical_device, &native_properties);
+   struct venus_import_memory_type native_types[VK_MAX_MEMORY_TYPES];
+   for (uint32_t i = 0; i < native_properties.memoryTypeCount; ++i) {
+      native_types[i].property_flags =
+         native_properties.memoryTypes[i].propertyFlags;
+      native_types[i].heap_index =
+         native_properties.memoryTypes[i].heapIndex;
+   }
+   return venus_import_select_native_type(
+      selected, compatible, property_flags, native_types,
+      native_properties.memoryTypeCount);
+}
+
+static bool
+vkr_android_dedicated_ahb_image(VkMemoryAllocateInfo *info,
+                                struct vkr_image **out_image)
+{
+   VkMemoryDedicatedAllocateInfo *dedicated = vkr_find_struct(
+      info->pNext, VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO);
+   if (!dedicated || !dedicated->image)
+      return false;
+   struct vkr_image *image = vkr_image_from_handle(dedicated->image);
+   if (!image || !image->android_hardware_buffer_external)
+      return false;
+   *out_image = image;
+   return true;
+}
+
+static VkResult
+vkr_android_prepare_ahb_import(struct vkr_device *dev,
+                              VkMemoryAllocateInfo *info,
+                              uint32_t property_flags, uint64_t object_id,
+                              AHardwareBuffer *buffer,
+                              VkImportAndroidHardwareBufferInfoANDROID *import)
+{
+   struct vkr_image *image = NULL;
+   if (!buffer || !vkr_android_dedicated_ahb_image(info, &image))
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   PFN_vkGetAndroidHardwareBufferPropertiesANDROID get_properties =
+      vkr_android_get_ahb_properties_proc(dev);
+   if (!get_properties)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+   VkAndroidHardwareBufferPropertiesANDROID properties = {
+      .sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID,
+   };
+   VkResult ret = get_properties(dev->base.handle.device, buffer, &properties);
+   if (ret != VK_SUCCESS)
+      return ret;
+   VkMemoryRequirements requirements = {0};
+   dev->proc_table.GetImageMemoryRequirements(
+      dev->base.handle.device, image->base.handle.image, &requirements);
+   const uint32_t compatible =
+      properties.memoryTypeBits & requirements.memoryTypeBits;
+   const uint32_t selected = vkr_android_select_import_type(
+      dev, info->memoryTypeIndex, compatible, property_flags);
+   if (selected == VENUS_IMPORT_TYPE_INVALID)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   info->allocationSize = properties.allocationSize;
+   info->memoryTypeIndex = selected;
+   *import = (VkImportAndroidHardwareBufferInfoANDROID) {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID,
+      .pNext = info->pNext,
+      .buffer = buffer,
+   };
+   vkr_log("VIRUAISOR_AHB_IMAGE_IMPORT object=%" PRIu64
+           " width=%u height=%u allocation=%" PRIu64
+           " types=%x compatible=%x target=%u",
+           object_id, image->extent.width, image->extent.height,
+           properties.allocationSize, properties.memoryTypeBits,
+           compatible, selected);
+   return VK_SUCCESS;
+}
