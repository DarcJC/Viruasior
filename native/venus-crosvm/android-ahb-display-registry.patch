 #include <inttypes.h>
 #include <fcntl.h>
 #include <linux/dma-heap.h>
@@ -31,3 +32,53 @@
+#define VIRUAISOR_AHB_REGISTRY_CAPACITY 4096
+static struct venus_ahb_registry_entry
+   viruaisor_ahb_registry[VIRUAISOR_AHB_REGISTRY_CAPACITY];
+static pthread_mutex_t viruaisor_ahb_registry_mutex = PTHREAD_MUTEX_INITIALIZER;
+void *viruaisor_ahb_acquire_from_fd(int fd);
+
+static bool
+viruaisor_ahb_register(int fd, AHardwareBuffer *buffer)
+{
+   struct stat st;
+   if (fd < 0 || !buffer || fstat(fd, &st))
+      return false;
+   pthread_mutex_lock(&viruaisor_ahb_registry_mutex);
+   const bool added = venus_ahb_registry_add(
+      viruaisor_ahb_registry, VIRUAISOR_AHB_REGISTRY_CAPACITY,
+      (uint64_t)st.st_dev, (uint64_t)st.st_ino, buffer);
+   pthread_mutex_unlock(&viruaisor_ahb_registry_mutex);
+   return added;
+}
+
+static void
+viruaisor_ahb_unregister(int fd, AHardwareBuffer *buffer)
+{
+   struct stat st;
+   if (fd < 0 || !buffer || fstat(fd, &st))
+      return;
+   pthread_mutex_lock(&viruaisor_ahb_registry_mutex);
+   (void)venus_ahb_registry_remove(
+      viruaisor_ahb_registry, VIRUAISOR_AHB_REGISTRY_CAPACITY,
+      (uint64_t)st.st_dev, (uint64_t)st.st_ino, buffer);
+   pthread_mutex_unlock(&viruaisor_ahb_registry_mutex);
+}
+
+/* Same-process display bridge: the caller owns the returned AHB reference. */
+void *
+viruaisor_ahb_acquire_from_fd(int fd)
+{
+   struct stat st;
+   if (fd < 0 || fstat(fd, &st))
+      return NULL;
+   pthread_mutex_lock(&viruaisor_ahb_registry_mutex);
+   AHardwareBuffer *buffer = venus_ahb_registry_find(
+      viruaisor_ahb_registry, VIRUAISOR_AHB_REGISTRY_CAPACITY,
+      (uint64_t)st.st_dev, (uint64_t)st.st_ino);
+   if (buffer)
+      AHardwareBuffer_acquire(buffer);
+   pthread_mutex_unlock(&viruaisor_ahb_registry_mutex);
+   return buffer;
+}
+
