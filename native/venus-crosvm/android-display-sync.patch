+bool
+vkr_context_wait_ring_seqno_timeout(struct vkr_context *ctx,
+                                    struct vkr_ring *ring,
+                                    uint64_t ring_seqno,
+                                    uint64_t timeout_ns,
+                                    bool *out_reached)
+{
+   TRACE_FUNC();
+   assert(out_reached);
+
+   struct timespec abs_ts;
+   if (!timespec_get(&abs_ts, TIME_UTC))
+      return false;
+   const struct timespec timeout = {
+      .tv_sec = timeout_ns / 1000000000ull,
+      .tv_nsec = timeout_ns % 1000000000ull,
+   };
+   abs_ts = timespec_add(abs_ts, timeout);
+
+   bool ok = true;
+   mtx_lock(&ctx->wait_ring.mutex);
+   ctx->wait_ring.id = ring->id;
+   ctx->wait_ring.seqno = ring_seqno;
+   while (!vkr_context_get_fatal(ctx) &&
+          !vkr_seqno_ge(vkr_ring_load_head(ring), ring_seqno)) {
+      const int ret = cnd_timedwait(&ctx->wait_ring.cond,
+                                    &ctx->wait_ring.mutex, &abs_ts);
+      /* Mesa's POSIX C11 shim maps ETIMEDOUT to thrd_busy.  Accept both
+       * values because other C11 implementations use thrd_timeout. */
+      if (ret == thrd_timeout || ret == thrd_busy)
+         break;
+      if (ret != thrd_success) {
+         ok = false;
+         break;
+      }
+   }
+   *out_reached = vkr_seqno_ge(vkr_ring_load_head(ring), ring_seqno);
+   ctx->wait_ring.id = 0;
+   mtx_unlock(&ctx->wait_ring.mutex);
+   return ok && !vkr_context_get_fatal(ctx);
+}
