+struct vkr_renderer_wait *
+vkr_renderer_prepare_wait_idle(uint32_t ctx_id)
+{
+   TRACE_FUNC();
+
+   struct vkr_context *ctx = vkr_renderer_lookup_context(ctx_id);
+   if (!ctx)
+      return NULL;
+
+   unsigned ring_count = 0;
+   mtx_lock(&ctx->ring_mutex);
+   list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head)
+      ring_count++;
+
+   struct vkr_renderer_wait *wait =
+      calloc(1, sizeof(*wait) + ring_count * sizeof(wait->rings[0]));
+   if (!wait) {
+      mtx_unlock(&ctx->ring_mutex);
+      return NULL;
+   }
+
+   wait->ctx = ctx;
+   wait->ctx_id = ctx_id;
+   wait->ring_count = ring_count;
+   unsigned ring_index = 0;
+   list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head) {
+      wait->rings[ring_index].ring = ring;
+      wait->rings[ring_index].tail =
+         atomic_load_explicit(ring->control.tail, memory_order_acquire);
+      ring_index++;
+   }
+   mtx_unlock(&ctx->ring_mutex);
+   return wait;
+}
+
+bool
+vkr_renderer_finish_wait_idle(struct vkr_renderer_wait *wait)
+{
+   TRACE_FUNC();
+   if (!wait)
+      return false;
+
+   /* VIRUAISOR_DISPLAY_SYNC_BOUNDED_RING_DRAIN
+    * prepare runs under renderer_mutex, keeping context lookup and ring
+    * snapshot consistent.  finish runs after that mutex is released because
+    * a ring can need to submit a round-trip command before advancing its head.
+    */
+   for (unsigned i = 0; i < wait->ring_count; i++) {
+      struct vkr_ring *ring = wait->rings[i].ring;
+      const uint32_t tail = wait->rings[i].tail;
+      vkr_ring_notify(ring);
+      bool drained = false;
+      if (!vkr_context_wait_ring_seqno_timeout(wait->ctx, ring, tail,
+                                               5000000, &drained)) {
+         vkr_log("VIRUAISOR_DISPLAY_SYNC_RING_FAILED ctx=%u ring=%" PRIu64
+                 " tail=%u", wait->ctx_id, ring->id, tail);
+         free(wait);
+         return false;
+      }
+      if (!drained)
+         vkr_log("VIRUAISOR_DISPLAY_SYNC_DEFERRED ctx=%u ring=%" PRIu64
+                 " head=%u tail=%u", wait->ctx_id, ring->id,
+                 vkr_ring_load_head(ring), tail);
+   }
+
+   /* DMA_BUF_IOCTL_SYNC(START|READ) waits for the exporter's implicit fence.
+    * Do not call vkDeviceWaitIdle or block queue submission here.
+    */
+   vkr_log("VIRUAISOR_DISPLAY_SYNC_READY ctx=%u rings=%u",
+           wait->ctx_id, wait->ring_count);
+   free(wait);
+   return true;
+}
