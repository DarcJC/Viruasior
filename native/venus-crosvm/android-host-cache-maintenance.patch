diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -37,6 +37,27 @@
    viruaisor_ahb_registry[VIRUAISOR_AHB_REGISTRY_CAPACITY];
 static pthread_mutex_t viruaisor_ahb_registry_mutex = PTHREAD_MUTEX_INITIALIZER;
 static struct venus_uncached_entry uncached_entries[VENUS_UNCACHED_MAX_LEASES];
+
+bool
+vkr_android_uncached_cache_maintain(struct vkr_context *owner, bool completed)
+{
+   struct venus_uncached_snapshot snapshot;
+   snapshot.count = 0;
+   /* Preserve ordering within a context without blocking unrelated contexts
+    * during the cache-line sweep. Pins keep mappings and helper leases alive. */
+   mtx_lock(&owner->android_cache_mutex);
+   pthread_mutex_lock(&viruaisor_ahb_registry_mutex);
+   bool okay = venus_uncached_snapshot_take(uncached_entries, owner->ctx_id, &snapshot);
+   pthread_mutex_unlock(&viruaisor_ahb_registry_mutex);
+   if (okay) {
+      okay = venus_uncached_cache_maintain(&snapshot, completed);
+      pthread_mutex_lock(&viruaisor_ahb_registry_mutex);
+      venus_uncached_snapshot_drop(&snapshot);
+      pthread_mutex_unlock(&viruaisor_ahb_registry_mutex);
+   }
+   mtx_unlock(&owner->android_cache_mutex);
+   return okay;
+}
 
 static void
 vkr_android_uncached_release(int fd)
