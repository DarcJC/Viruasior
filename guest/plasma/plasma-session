#!/bin/sh
set -eu
if [ "${1:-}" != --session ]; then
    exec dbus-run-session -- "$0" --session
fi
mkdir -p "$HOME/.config"
cat > "$HOME/.config/kwinrc" <<'EOF'
[Compositing]
Enabled=true
Backend=OpenGL
[Plugins]
viruaisor_full_repaintEnabled=true
EOF
export KWIN_COMPOSE=O2
# Shared scanout contents are not preserved as required by KWin buffer age.
# Repaint the full GL back buffer; partial repaint otherwise flashes black tiles.
export KWIN_USE_BUFFER_AGE=0
# Restrict only the compositor, leaving Plasma and user applications free to
# use all vCPUs. Prefer large cores, excluding the prime tier when present.
export KDEWM=/opt/viruaisor/desktop-kwin
startplasma-x11 &
plasma_pid=$!
compositor_pid=
cleanup() {
    if [ -n "$compositor_pid" ]; then
        kill "$compositor_pid" 2>/dev/null || true
        wait "$compositor_pid" 2>/dev/null || true
        compositor_pid=
    fi
    kill "$plasma_pid" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM
report="$XDG_RUNTIME_DIR/viruaisor-kwin.txt"
count=0
while [ "$count" -lt 90 ]; do
    kill -0 "$plasma_pid" || exit 1
    if qdbus org.kde.KWin /KWin supportInformation > "$report" 2>/dev/null &&
        grep -q 'Compositing is active' "$report" &&
        grep -q 'Compositing Type: OpenGL' "$report" &&
        grep -Eiq 'OpenGL renderer string:.*zink.*mali' "$report" &&
        [ "$(qdbus org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded viruaisor_full_repaint 2>/dev/null)" = true ] &&
        ! grep -Eiq 'llvmpipe|lavapipe|swiftshader|softpipe' "$report"; then
        cat "$report"
        # avf-plasma.service only starts this session after venus-preflight has
        # proved MESA_VENUS on Mali and completed a GPU draw/readback.
        echo 'VIRUAISOR_KWIN_COMPOSITING=opengl'
        echo 'VIRUAISOR_FULL_REPAINT=true'
        echo 'VIRUAISOR_PLASMA_HARDWARE_READY=true'
        # Keep OpenGL composition at native 60 Hz; the measured 1920-wide
        # 120 Hz modes avoid a redundant composition pass. The supervisor
        # restores its own suspension on exit or observer failure.
        /opt/viruaisor/desktop-compositor &
        compositor_pid=$!
        wait "$plasma_pid"
        exit $?
    fi
    sleep 1
    count=$((count+1))
done
cat "$report" >&2 2>/dev/null || true
echo 'Plasma session did not confirm KWin OpenGL on Zink/Venus/Mali' >&2
exit 1
