MESA_LOADER_DRIVER_OVERRIDE=zink
GALLIUM_DRIVER=zink
LIBGL_ALWAYS_SOFTWARE=0
VIRUAISOR_ZINK_DISABLE_DRM_MODIFIERS=1
VK_DRIVER_FILES=/opt/viruaisor/venus/venus_icd.json
VK_ICD_FILENAMES=/opt/viruaisor/venus/venus_icd.json
VN_PERF=no_fence_feedback,no_semaphore_feedback,no_event_feedback,no_query_feedback
LD_LIBRARY_PATH=/opt/viruaisor/zink25/lib
LIBGL_DRIVERS_PATH=/opt/viruaisor/zink25/lib/dri
__EGL_VENDOR_LIBRARY_FILENAMES=/opt/viruaisor/zink25/share/glvnd/egl_vendor.d/50_mesa.json
XDG_RUNTIME_DIR=/run/user/1000
XDG_SESSION_TYPE=x11
XDG_SESSION_CLASS=user
XDG_CURRENT_DESKTOP=KDE
QT_QUICK_BACKEND=software
KWIN_COMPOSE=O2
KWIN_USE_BUFFER_AGE=0
KWIN_OPENGL_INTERFACE=glx
QT_XCB_GL_INTEGRATION=xcb_glx
