[Unit]
Description=Viruaisor Manjaro Plasma desktop with required Venus GPU acceleration
After=systemd-user-sessions.service
After=getty@tty1.service
Conflicts=getty@tty1.service
ConditionPathExists=/opt/viruaisor/venus/venus_icd.json

[Service]
Type=simple
User=droid
Group=users
SupplementaryGroups=video render input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
EnvironmentFile=/etc/viruaisor/venus.env
WorkingDirectory=/home/droid
ExecStartPre=/usr/bin/timeout 40 /opt/viruaisor/venus-preflight
ExecStart=/usr/bin/startx /opt/viruaisor/plasma-session -- /opt/viruaisor/desktop-xorg :0 vt1 -keeptty -nolisten tcp
# The GPU preflight has its own 40-second bound. Keep the long-running X session
# out of systemd's start timer; older systemd/PAM combinations otherwise leave
# this long-running unit activating and hang up tty1 after 90+15 seconds.
TimeoutStartSec=0
TimeoutStopSec=15
KillMode=control-group

# Started only by START_DESKTOP venus after the host Surface is attached.
